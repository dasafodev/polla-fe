# false = usa el API real (dev: vía proxy /api; build: VITE_API_BASE_URL directo). true = mocks in-process.
VITE_USE_MOCKS=false
# Dev: /api (proxied por Vite a https://api.paulpredice.com). Build: https://api.paulpredice.com
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=replace-with-oauth-client-id
